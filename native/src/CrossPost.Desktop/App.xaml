<Application x:Class="CrossPost.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Panel" Color="#1A1E27"/>
  <Style TargetType="Window"><Setter Property="Background" Value="#10131A"/><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#242A36"/><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#41495C"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,0,14"/><Setter Property="FontSize" Value="15"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#242A36"/><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,0,14"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#6366DA"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="#8286F1" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#7477EC"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#4D50B3"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#30384A"/><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#41495C"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF0F7"/><Setter Property="Margin" Value="0,10,0,14"/></Style>
 </Application.Resources>
</Application>
