<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <ApplicationIcon>../../../app/web/crosspost.ico</ApplicationIcon>
    <Version>0.1.0</Version><AssemblyName>CrossPost.Native</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CrossPost.Core/CrossPost.Core.csproj"/>
    <Resource Include="../../../app/web/crosspost.ico" Link="Assets/CrossPost.ico"/>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11"/>
  </ItemGroup>
</Project>
