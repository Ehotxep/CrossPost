<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <ApplicationIcon>../../../app/web/crosspost.ico</ApplicationIcon>
    <Version>0.0.11-dev</Version><AssemblyName>CrossPost.Native</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CrossPost.Core/CrossPost.Core.csproj"/>
    <ProjectReference Include="../CrossPost.Update/CrossPost.Update.csproj"/>
    <Resource Include="Assets/Fonts/*.ttf"/>
    <None Update="Assets/Fonts/LICENSE-Inter.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Resource Include="../../../app/web/crosspost.ico" Link="Assets/CrossPost.ico"/>
  </ItemGroup>
</Project>
