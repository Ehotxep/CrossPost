<Window x:Class="CrossPost.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="/Assets/CrossPost.ico" Title="CrossPost Native — прототип" Width="1100" Height="800" MinWidth="850" MinHeight="650">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20">
   <TextBlock Text="crosspost / native" FontSize="24" FontWeight="SemiBold" Margin="0,0,30,0" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal">
    <Button Content="Новый пост" Click="ShowCompose"/><Button Content="История" Click="ShowHistory"/><Button Content="Настройки" Click="ShowSettings"/>
   </StackPanel>
   <TextBlock x:Name="ModeLabel" Text="ДЕМО • ничего не публикуется" Foreground="#65DBB2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <ScrollViewer x:Name="ComposeView" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
     <TextBlock Text="Новый пост" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBlock Text="Заголовок"/><TextBox x:Name="TitleInput" TextChanged="DraftChanged"/>
     <TextBlock Text="Описание"/><TextBox x:Name="BodyInput" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged"/>
     <WrapPanel><Button Content="Добавить изображения" Click="PickImage"/><Button Content="Убрать выбранное" Click="RemoveImage"/><Button Content="Новый черновик" Click="ClearDraft"/></WrapPanel>
     <WrapPanel><Button Content="Выше" Click="MoveImageUp"/><Button Content="Ниже" Click="MoveImageDown"/></WrapPanel>
     <ListBox x:Name="ImageList" MaxHeight="130" Background="#242A36" Foreground="#EDF0F7" DisplayMemberPath="Label" SelectionChanged="ImageSelected"/>
     <TextBlock x:Name="ImageLabel" TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,8,0,8"/>
     <Image x:Name="PreviewImage" Height="130" Stretch="Uniform" HorizontalAlignment="Left"/>
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,14,0,14">
      <StackPanel><TextBlock Text="Предпросмотр текста Telegram" FontWeight="SemiBold"/><TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="CountLabel" Foreground="#ABB5CA" Margin="0,10,0,0"/></StackPanel>
     </Border>
     <TextBlock x:Name="DestinationLabel" TextWrapping="Wrap"/>
     <WrapPanel Margin="0,10,0,12"><Button x:Name="SendButton" Content="Выполнить демо-отправку" Click="SendPost"/><Button Content="Сохранить черновик" Click="SaveDraftClick"/></WrapPanel>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="HistoryView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="История" FontSize="26" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Обновить" HorizontalAlignment="Right" Click="RefreshHistory"/></DockPanel>
    <ListView Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="HistorySelected" Background="#1A1E27" Foreground="#EDF0F7" Margin="0,12,0,10">
     <ListView.View><GridView>
      <GridViewColumn Header="Дата" Width="145" DisplayMemberBinding="{Binding CreatedText}"/>
      <GridViewColumn Header="Пост" Width="260" DisplayMemberBinding="{Binding Title}"/>
      <GridViewColumn Header="Результат" Width="200" DisplayMemberBinding="{Binding Status}"/>
      <GridViewColumn Header="Режим" Width="85" DisplayMemberBinding="{Binding Mode}"/>
     </GridView></ListView.View>
    </ListView>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="HistoryDetails" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="Изменить текст или подпись (обычный текст)"/>
     <TextBox x:Name="EditInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel><Button x:Name="EditButton" Content="Сохранить изменение" Click="EditPost" IsEnabled="False"/><Button Content="Открыть сообщение" Click="OpenPost"/></WrapPanel>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <TextBlock Text="Настройки Telegram" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <CheckBox x:Name="DemoInput" Content="Демонстрационный режим — без запросов в Telegram" IsChecked="True"/>
     <TextBlock Text="Канал: @имя или -100…"/><TextBox x:Name="ChatInput" MinWidth="550"/>
     <TextBlock Text="Токен бота из @BotFather"/><PasswordBox x:Name="TokenInput"/>
     <TextBlock Text="Токен сохраняется с защитой Windows для текущего пользователя. Бот должен быть администратором выбранного канала." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Сохранить настройки" Click="SaveSettings"/><Button Content="Проверить бота" Click="CheckBot"/><Button Content="Открыть папку данных" Click="OpenData"/></WrapPanel>
     <TextBlock Text="В прототипе: текст, до 10 изображений JPEG/PNG одним альбомом, история и редактирование. Альбомы, MTProto, расписание, импорт Python-данных и другие площадки ещё не подключены." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,20,0,12"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12" Margin="0,18,0,0">
   <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отменить" Click="CancelOperation" Visibility="Collapsed"/><StackPanel><TextBlock x:Name="StatusLabel" Text="Загрузка…" TextWrapping="Wrap"/><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></DockPanel>
  </Border>
 </Grid>
</Window>
