<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CrossPost.Desktop.MainWindow" Style="{StaticResource AppWindowStyle}" Icon="/Assets/CrossPost.ico" Title="CrossPost Native" Width="1360" Height="900" MinWidth="850" MinHeight="650">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" />
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Border MinHeight="56" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto" />
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
     <Image Source="/Assets/CrossPost.ico" Width="24" Height="24" Margin="0,0,8,0" />
     <TextBlock Text="crosspost" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
    </StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
     <Button x:Name="NavCompose" Style="{StaticResource NavigationStyle}" Content="Новый пост" Click="ShowCompose" />
     <Button x:Name="NavLibrary" Style="{StaticResource NavigationStyle}" Content="Публикации" Click="ShowLibrary" />
     <Button x:Name="NavStats" Style="{StaticResource NavigationStyle}" Content="Статистика" Click="ShowLibraryStats" />
     <Button x:Name="NavSettings" Style="{StaticResource NavigationStyle}" Content="Настройки" Click="ShowSettings" />
    </WrapPanel>
    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
     <Button x:Name="UpdateNotice" Style="{StaticResource BadgeButtonStyle}" Content="Обновление" Click="ShowSettings" Visibility="Collapsed" />
     <Button x:Name="WorkerTopButton" Style="{StaticResource BadgeButtonStyle}" Click="ShowQueue">
      <StackPanel Orientation="Horizontal">
       <Ellipse x:Name="WorkerTopLamp" Fill="{StaticResource MutedBrush}" Width="7" Height="7" Margin="0,0,7,0" />
       <TextBlock x:Name="WorkerTopText" Text="Очередь" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
    </WrapPanel>
   </Grid>
  </Border>
  <Grid x:Name="MainContent" Grid.Row="1" MaxWidth="1320" Margin="28,22,28,16">
   <Grid x:Name="ComposeScreen">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
     <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
      <TextBlock Text="Черновик сохраняется автоматически" Style="{StaticResource MutedTextStyle}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
      <Button Content="Новый черновик" Click="ClearDraft" />
     </WrapPanel>
     <TextBlock Text="Новый пост" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
    </DockPanel>
    <Grid x:Name="ComposeColumns" Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition x:Name="PublicationColumn" Width="380" />
     </Grid.ColumnDefinitions>
     <ScrollViewer x:Name="ComposeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <StackPanel>
       <Border x:Name="MediaCard" Style="{StaticResource CardStyle}" AllowDrop="True" DragOver="ImageFilesDragOver" Drop="ImageFilesDrop">
        <StackPanel>
         <DockPanel Margin="0,0,0,14">
          <TextBlock Text="JPEG / PNG" Style="{StaticResource MutedTextStyle}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <TextBlock Text="Файлы" Style="{StaticResource SectionTitleStyle}" />
         </DockPanel>
         <Button x:Name="FileDropButton" Style="{StaticResource DropAreaStyle}" Click="PickImage">
          <StackPanel HorizontalAlignment="Center">
           <TextBlock Text="＋" FontSize="26" Foreground="{StaticResource AccentInkBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
           <TextBlock Text="Перетащите изображения сюда" FontWeight="SemiBold" HorizontalAlignment="Center" />
           <TextBlock Text="или нажмите, чтобы выбрать JPEG и PNG" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
          </StackPanel>
         </Button>
         <ListBox x:Name="ImageList" MaxHeight="220" Background="Transparent" BorderThickness="0" SelectionChanged="ImageSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
           <ItemsPanelTemplate>
            <WrapPanel />
           </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
           <DataTemplate>
            <StackPanel Width="120" Margin="2">
             <Border Background="{StaticResource FieldBrush}" CornerRadius="8" ClipToBounds="True">
              <Image Source="{Binding Thumbnail}" Height="82" Width="120" Stretch="UniformToFill" />
             </Border>
             <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,6,0,0" />
            </StackPanel>
           </DataTemplate>
          </ListBox.ItemTemplate>
         </ListBox>
         <WrapPanel x:Name="MediaManageBar" Margin="0,8,0,0">
          <Button Content="Добавить файлы" Click="PickImage" />
          <Button x:Name="RemoveImageButton" Content="Убрать" Click="RemoveImage" />
          <Button x:Name="MoveImageUpButton" Content="↑" ToolTip="Переместить выше" Click="MoveImageUp" />
          <Button x:Name="MoveImageDownButton" Content="↓" ToolTip="Переместить ниже" Click="MoveImageDown" />
         </WrapPanel>
         <TextBlock x:Name="ImageLabel" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
         <Expander x:Name="MediaPreviewExpander" Header="Посмотреть выбранное изображение" Margin="0,10,0,0">
          <Image x:Name="PreviewImage" Visibility="Collapsed" Height="180" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,10,0,0" />
         </Expander>

          <WrapPanel>
           <TextBlock Text="Рейтинг публикации" VerticalAlignment="Center" Margin="0,0,10,0" />
           <ComboBox x:Name="BlueskyRating" Width="180" SelectedIndex="0" SelectionChanged="BlueskyRatingChanged">
            <ComboBoxItem Content="SFW" />
            <ComboBoxItem Content="Эротика • nudity" />
            <ComboBoxItem Content="Откровенное • porn" />
           </ComboBox>
          </WrapPanel>
         <StackPanel x:Name="BlueskyComposer" Visibility="Collapsed" Margin="0,8,0,8">
          <TextBlock Text="ALT выбранного изображения" Margin="0,8,0,0" />
          <TextBox x:Name="ImageAltInput" TextChanged="ImageAltChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="65" />
          <Button Content="Подготовить копии для Bluesky" Click="PrepareBlueskyImages" HorizontalAlignment="Left" />
          <TextBlock Text="До 4 изображений по 2 000 000 байт. Подготовка сохраняет PNG с прозрачностью, если он помещается; иначе создаёт JPEG на белом фоне. Оригиналы сохраняются. Результат появится в предпросмотре." TextWrapping="Wrap" Foreground="#B4B9C6" />
         </StackPanel>
        </StackPanel>
       </Border>
       <Border x:Name="TextCard" Style="{StaticResource CardStyle}">
        <StackPanel>
         <DockPanel Margin="0,0,0,16">
          <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
           <RadioButton x:Name="MainLanguageRu" Style="{StaticResource SegmentRadioStyle}" GroupName="MainTextLanguage" Content="Русский" IsChecked="True" Checked="TextLanguageChanged" />
           <RadioButton x:Name="MainLanguageBoth" Style="{StaticResource SegmentRadioStyle}" GroupName="MainTextLanguage" Content="Оба" Checked="TextLanguageChanged" />
           <RadioButton x:Name="MainLanguageEnglish" Style="{StaticResource SegmentRadioStyle}" GroupName="MainTextLanguage" Content="English" Checked="TextLanguageChanged" />
          </WrapPanel>
          <TextBlock Text="Текст" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
         </DockPanel>
         <Grid x:Name="BilingualGrid">
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto" />
           <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*" />
           <ColumnDefinition x:Name="BilingualGap" Width="24" />
           <ColumnDefinition x:Name="EnglishColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="Русский · основной" FontWeight="SemiBold" Margin="0,0,0,10" />
           <TextBlock Text="Заголовок" Style="{StaticResource FieldLabelStyle}" />
           <TextBox x:Name="TitleInput" TextChanged="DraftChanged" />
           <TextBlock Text="Описание" Style="{StaticResource FieldLabelStyle}" />
           <TextBox x:Name="BodyInput" Height="144" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" />
          </StackPanel>
          <Expander x:Name="EnglishEditor" Grid.Column="2" Header="English" IsExpanded="True">
           <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="EnglishTitleInput" TextChanged="DraftChanged" />
            <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="EnglishBodyInput" Height="144" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" />
           </StackPanel>
          </Expander>
         </Grid>
         <TextBlock Text="«Оба» — русский и английский в одном посте. Английский вариант пока вводится вручную." Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
         <WrapPanel Margin="0,0,0,8">
          <TextBlock Text="Посмотреть для" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ComboBox x:Name="PlatformPicker" Width="180" SelectedIndex="0" SelectionChanged="PlatformChanged">
           <ComboBoxItem Content="Telegram" />
           <ComboBoxItem Content="Discord" />
           <ComboBoxItem Content="Bluesky" />
          </ComboBox>
         </WrapPanel>
         <Border Margin="0,14,0,0" Style="{StaticResource InsetPanelStyle}">
          <StackPanel>
           <TextBlock x:Name="PlatformTextHeading" Text="Текст для Telegram" FontWeight="SemiBold" />
           <WrapPanel Margin="0,6,0,6">
            <TextBlock Text="Язык площадки" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="PlatformLanguage" Width="200" SelectedIndex="0" SelectionChanged="PlatformLanguageChanged">
             <ComboBoxItem Content="Как в общем тексте" />
             <ComboBoxItem Content="Русский" />
             <ComboBoxItem Content="Оба" />
             <ComboBoxItem Content="English" />
            </ComboBox>
           </WrapPanel>
           <CheckBox x:Name="CustomTextToggle" Content="Использовать отдельный текст для этой площадки" Visibility="Collapsed" Checked="CustomTextToggled" Unchecked="CustomTextToggled" />
           <Expander x:Name="PlatformTextEditor" Header="Отдельные заголовки и описания" Margin="0,8,0,0">
            <StackPanel x:Name="CustomTextFields" Visibility="Collapsed" Margin="8">
             <TextBlock Text="Русский · заголовок" />
             <TextBox x:Name="CustomTitleInput" TextChanged="CustomTextChanged" />
             <TextBlock Text="Русский · описание" />
             <TextBox x:Name="CustomBodyInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CustomTextChanged" />
             <TextBlock Text="English · title" />
             <TextBox x:Name="CustomEnglishTitleInput" TextChanged="CustomTextChanged" />
             <TextBlock Text="English · description" />
             <TextBox x:Name="CustomEnglishBodyInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CustomTextChanged" />
            </StackPanel>
           </Expander>
           <TextBlock Text="Отдельные тексты включаются для каждой площадки в настройках. Язык можно выбрать независимо от отдельного текста." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,6,0,0" />
          </StackPanel>
         </Border>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource CardStyle}">
        <StackPanel>
         <DockPanel>
          <TextBlock x:Name="ModeLabel" Style="{StaticResource MutedTextStyle}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right" />
          <TextBlock Text="Как будет выглядеть" Style="{StaticResource SectionTitleStyle}" />
         </DockPanel>
         <TextBlock x:Name="PreviewHeading" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,10,0,12" />
         <Border Style="{StaticResource InsetPanelStyle}">
          <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
         </Border>
         <TextBlock x:Name="CountLabel" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
         <TextBlock x:Name="DestinationLabel" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <Border x:Name="PublicationSidebar" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" VerticalAlignment="Stretch">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
       </Grid.RowDefinitions>
       <DockPanel Margin="0,0,0,14">
        <TextBlock x:Name="SelectedDestinationCount" Text="1 место" Style="{StaticResource MutedTextStyle}" FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Text="Публикация" Style="{StaticResource SectionTitleStyle}" />
       </DockPanel>
       <StackPanel Grid.Row="1">
        <CheckBox x:Name="TargetTelegram" Style="{StaticResource DestinationToggleStyle}" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged" IsChecked="True">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="32" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#299FD0" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
           <TextBlock Text="TG" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
           <TextBlock Text="Telegram" FontWeight="SemiBold" />
           <TextBlock x:Name="TargetTelegramInfo" Text="ДЕМО" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </Grid>
        </CheckBox>
        <CheckBox x:Name="TargetDiscord" Style="{StaticResource DestinationToggleStyle}" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="32" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#6673F2" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
           <TextBlock Text="DS" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
           <TextBlock Text="Discord" FontWeight="SemiBold" />
           <TextBlock x:Name="TargetDiscordInfo" Text="ДЕМО" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </Grid>
        </CheckBox>
        <CheckBox x:Name="TargetBluesky" Style="{StaticResource DestinationToggleStyle}" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="32" />
           <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Background="#208BFE" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
           <TextBlock Text="BS" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1">
           <TextBlock Text="Bluesky" FontWeight="SemiBold" />
           <TextBlock x:Name="TargetBlueskyInfo" Text="ДЕМО" Style="{StaticResource MutedTextStyle}" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </Grid>
        </CheckBox>
        <TextBlock x:Name="ExtraDestinationHeading" Text="Другие каналы" FontWeight="SemiBold" Margin="0,12,0,4" />
        <ItemsControl x:Name="ExtraDestinations">
         <ItemsControl.ItemTemplate><DataTemplate>
          <CheckBox Content="{Binding Label}" ToolTip="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" IsEnabled="{Binding Eligible}" Checked="ExtraDestinationChanged" Unchecked="ExtraDestinationChanged" Margin="0,4,0,4"><CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="210" /></DataTemplate></CheckBox.ContentTemplate></CheckBox>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Управление каналами…" Click="ShowDestinations" HorizontalAlignment="Left" />
        <TextBlock x:Name="TargetSummary" Style="{StaticResource MutedTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10" />
       </StackPanel>
       <StackPanel x:Name="ComposeActions" Grid.Row="2">
        <Button x:Name="SendButton" Style="{StaticResource PrimaryButtonStyle}" Content="Опубликовать сейчас" Click="SendPost" Margin="0,4,0,8" Padding="12,12" />
        <Button Content="В очередь" Click="QueueNow" Margin="0,0,0,8" />
        <Button Content="Сохранить черновик" Click="SaveDraftClick" Margin="0,0,0,12" />
       </StackPanel>
       <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
         <Expander Header="Запланировать" Margin="0,4,0,12">
          <StackPanel Margin="0,10,0,0">
           <TextBlock x:Name="ScheduleZoneLabel" Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
           <DatePicker x:Name="ScheduleDate" Margin="0,8,0,8" />
           <TextBox x:Name="ScheduleClock" Text="12:00" Margin="0,0,0,8" />
           <Button Content="Запланировать" Click="SchedulePost" Margin="0" />
          </StackPanel>
         </Expander>
         <TextBlock Text="Очередь продолжит отправку после закрытия окна, пока включён компьютер." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
         <Button Content="Открыть очередь →" Style="{StaticResource LinkButtonStyle}" Click="ShowQueue" HorizontalAlignment="Left" />
        </StackPanel>
       </ScrollViewer>
      </Grid>
     </Border>
    </Grid>
   </Grid>
   <Grid x:Name="HistoryView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*" />
     <ColumnDefinition Width="340" x:Name="HistoryDetailsColumn" />
    </Grid.ColumnDefinitions>
    <DockPanel Grid.ColumnSpan="2">
     <TextBlock Text="История" Style="{StaticResource PageTitleStyle}" />
     <Button DockPanel.Dock="Right" Content="Обновить" HorizontalAlignment="Right" Click="RefreshHistory" />
     <Button Content="← Публикации" Click="ShowLibrary" HorizontalAlignment="Right" />
    </DockPanel>
    <ListView Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="HistorySelected" Background="#1A1D24" Foreground="#E8EAF0" Margin="0,12,16,0">
     <ListView.View>
      <GridView>
       <GridViewColumn Header="Дата" Width="145" DisplayMemberBinding="{Binding CreatedText}" />
       <GridViewColumn Header="Пост" Width="260" DisplayMemberBinding="{Binding Title}" />
       <GridViewColumn Header="Результат" Width="200" DisplayMemberBinding="{Binding Status}" />
       <GridViewColumn Header="Режим" Width="160" DisplayMemberBinding="{Binding Mode}" />
      </GridView>
     </ListView.View>
    </ListView>
    <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Grid.Row="1" Grid.Column="1">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock x:Name="HistoryDetails" TextWrapping="Wrap" Margin="0,0,0,10" />
       <TextBlock Text="Изменить текст или подпись (обычный текст)" />
       <TextBox x:Name="EditInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
       <WrapPanel>
        <Button x:Name="EditButton" Content="Сохранить изменение" Click="EditPost" IsEnabled="False" />
        <Button Content="Открыть сообщение" Click="OpenPost" />
       </WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <Grid x:Name="QueueView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
     <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
     <Button Content="← Публикации" Click="ShowLibrary" DockPanel.Dock="Right" HorizontalAlignment="Right" />
     <TextBlock Text="Очередь публикаций" Style="{StaticResource PageTitleStyle}" Grid.Row="0" />
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,10,0,10">
     <TextBlock x:Name="WorkerLabel" TextWrapping="Wrap" />
     <WrapPanel>
      <Button Content="Запустить очередь" Click="StartWorker" />
      <Button Content="Остановить очередь" Click="StopWorker" />
      <Button Content="Обновить" Click="RefreshQueue" />
     </WrapPanel>
    </StackPanel>
    <ListView Grid.Row="2" x:Name="QueueList" ItemsSource="{Binding Queue}" SelectionChanged="QueueSelected" Background="#1A1D24" Foreground="#E8EAF0">
     <ListView.View>
      <GridView>
       <GridViewColumn Header="Когда (местное время)" Width="160" DisplayMemberBinding="{Binding DueText}" />
       <GridViewColumn Header="Пост" Width="220" DisplayMemberBinding="{Binding Title}" />
       <GridViewColumn Header="Назначение" Width="180" DisplayMemberBinding="{Binding Destination}" />
       <GridViewColumn Header="Состояние" Width="200" DisplayMemberBinding="{Binding Status}" />
      </GridView>
     </ListView.View>
    </ListView>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
     <TextBlock x:Name="QueueDetails" TextWrapping="Wrap" />
     <WrapPanel>
      <Button x:Name="PauseJobButton" Content="Приостановить" Click="PauseJob" IsEnabled="False" />
      <Button x:Name="ResumeJobButton" Content="Продолжить / перенести" Click="ResumeJob" IsEnabled="False" />
      <Button x:Name="CancelJobButton" Content="Отменить задание" Click="CancelJob" IsEnabled="False" />
      <Button x:Name="JobHistoryButton" Content="Результат в истории" Click="OpenJobHistory" IsEnabled="False" />
     </WrapPanel>
     <TextBlock Text="Для переноса выберите дату и время ниже. Повтор неизвестной или частичной отправки автоматически не выполняется." TextWrapping="Wrap" Foreground="#B4B9C6" />
     <WrapPanel Margin="0,5,0,0">
      <DatePicker x:Name="QueueDate" Width="145" Margin="0,4,10,4" />
      <TextBox x:Name="QueueClock" Width="85" Margin="0,4,10,4" />
     </WrapPanel>
    </StackPanel>
   </Grid>
   <Grid x:Name="LibraryView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <WrapPanel>
     <TextBlock Text="Публикации" Style="{StaticResource PageTitleStyle}" Margin="0,0,18,0" />
     <Button Content="Импорт Python-базы…" Click="ImportLegacy" />
     <Button Content="Обновить" Click="RefreshLibrary" />
     <CheckBox x:Name="IncludeDemo" Content="Демо" Checked="LibraryFilterChanged" Unchecked="LibraryFilterChanged" VerticalAlignment="Center" Margin="5" />
     <Button Content="Очередь" Click="ShowQueue" x:Name="NavQueue" />
     <Button Content="Журнал и правки" Click="ShowHistory" x:Name="NavHistory" />
    </WrapPanel>
    <Grid Grid.Row="1" Margin="0,8,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1.3*" />
     </Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
      <Border Style="{StaticResource CardStyle}">
       <StackPanel>
        <WrapPanel>
         <Button Content="‹" Click="PreviousLibraryMonth" />
         <TextBlock x:Name="LibraryMonthLabel" FontSize="18" VerticalAlignment="Center" Margin="4" />
         <Button Content="›" Click="NextLibraryMonth" />
         <Button Content="Месяц" Click="ClearLibraryDay" />
        </WrapPanel>
        <UniformGrid Columns="7">
         <TextBlock Text="Пн" />
         <TextBlock Text="Вт" />
         <TextBlock Text="Ср" />
         <TextBlock Text="Чт" />
         <TextBlock Text="Пт" />
         <TextBlock Text="Сб" />
         <TextBlock Text="Вс" />
        </UniformGrid>
        <ItemsControl x:Name="CalendarDays" Height="228">
         <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
           <UniformGrid Columns="7" />
          </ItemsPanelTemplate>
         </ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Button Content="{Binding Label}" Tag="{Binding Date}" Click="SelectLibraryDay" FontSize="11" Padding="0" Margin="1" Background="{Binding Background}" ToolTip="{Binding Detail}" />
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="LibrarySummary" TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,12,0,0" />
        <TextBlock x:Name="ImportSummary" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#4CD69B" />
       </StackPanel>
      </Border>
     </ScrollViewer>
     <Grid Grid.Column="1" Margin="16,0,0,0">
      <Grid.RowDefinitions>
       <RowDefinition Height="*" />
       <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ListView x:Name="WorkList" SelectionMode="Extended" SelectionChanged="WorkSelected" Background="#1A1D24" Foreground="#E8EAF0">
       <ListView.View>
        <GridView>
         <GridViewColumn Header="Дата" Width="125" DisplayMemberBinding="{Binding DateLabel}" />
         <GridViewColumn Header="Работа" Width="230" DisplayMemberBinding="{Binding Title}" />
         <GridViewColumn Header="Площадки" Width="150" DisplayMemberBinding="{Binding Platforms}" />
         <GridViewColumn Header="Результат" Width="160" DisplayMemberBinding="{Binding StateLabel}" />
         <GridViewColumn Header="Связь" Width="160" DisplayMemberBinding="{Binding GroupLabel}" />
        </GridView>
       </ListView.View>
      </ListView>
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
       <WrapPanel>
        <Button Content="Объединить" Click="JoinWorks" ToolTip="Объединить любые выбранные работы, сохранив все публикации и замеры" />
        <Button Content="Разъединить" Click="SplitWorks" />
        <Button Content="Открыть" Click="OpenLibraryPost" />
       </WrapPanel>
       <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="WorkDetails" TextWrapping="Wrap" Foreground="#B4B9C6" />
       </ScrollViewer>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="LibraryStatsView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="Auto" />
     <RowDefinition Height="220" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <WrapPanel>
     <TextBlock Text="Статистика" Style="{StaticResource PageTitleStyle}" Margin="0,0,20,0" />
     <Button Content="Обновить локальные данные" Click="RefreshLibrary" />
    </WrapPanel>
    <TextBlock Grid.Row="1" Text="Фактические импортированные замеры. Для каждой работы и назначения учитывается последняя успешная публикация. Демо и исключённые записи не учитываются. «—» означает отсутствие данных." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,12,0,12" />
    <ListView Grid.Row="2" x:Name="TotalsList" Background="#1A1D24" Foreground="#E8EAF0">
     <ListView.View>
      <GridView>
       <GridViewColumn Header="Площадка" Width="130" DisplayMemberBinding="{Binding Platform}" />
       <GridViewColumn Header="Назначение" Width="180" DisplayMemberBinding="{Binding Target}" />
       <GridViewColumn Header="Публикаций" Width="100" DisplayMemberBinding="{Binding Publications}" />
       <GridViewColumn Header="Просмотры" Width="140" DisplayMemberBinding="{Binding ViewsLabel}" />
       <GridViewColumn Header="Реакции" Width="140" DisplayMemberBinding="{Binding ReactionsLabel}" />
      </GridView>
     </ListView.View>
    </ListView>
    <TextBlock Grid.Row="3" Text="Сеть и браузеры этот раздел не запускает. Подробные замеры по публикациям — в календаре. Сбор новых метрик и индекс успеха будут подключены отдельно." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,20,0,0" />
   </Grid>
   <Grid x:Name="SettingsView" Visibility="Collapsed">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto" />
     <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20" />
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
     </Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0">
      <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource EyebrowStyle}" Margin="10,0,0,8" />
      <Button x:Name="SettingsGeneralNav" Style="{StaticResource SettingsNavigationStyle}" Content="Общие" Tag="general" Click="ShowSettingsCategory" />
      <Button x:Name="SettingsMigrationNav" Style="{StaticResource SettingsNavigationStyle}" Content="Переход с Python" Tag="migration" Click="ShowSettingsCategory" />
      <Button x:Name="SettingsDestinationsNav" Style="{StaticResource SettingsNavigationStyle}" Content="Каналы публикации" Tag="destinations" Click="ShowSettingsCategory" />
      <Button x:Name="SettingsTextsNav" Style="{StaticResource SettingsNavigationStyle}" Content="Тексты площадок" Tag="texts" Click="ShowSettingsCategory" />
      <TextBlock Text="ПЛОЩАДКИ" Style="{StaticResource EyebrowStyle}" Margin="10,22,0,8" />
      <Button x:Name="SettingsTelegramNav" Style="{StaticResource SettingsNavigationStyle}" Content="Telegram" Tag="telegram" Click="ShowSettingsCategory" />
      <Button x:Name="SettingsDiscordNav" Style="{StaticResource SettingsNavigationStyle}" Content="Discord" Tag="discord" Click="ShowSettingsCategory" />
      <Button x:Name="SettingsBlueskyNav" Style="{StaticResource SettingsNavigationStyle}" Content="Bluesky" Tag="bluesky" Click="ShowSettingsCategory" />
     </StackPanel>
     <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
       <Border x:Name="SettingsGeneralPanel" Style="{StaticResource CardStyle}">
        <StackPanel>
         <TextBlock Text="Обновления CrossPost Native" Style="{StaticResource SectionTitleStyle}" />
         <TextBlock x:Name="UpdateVersionLabel" Margin="0,8,0,8" />
         <ComboBox x:Name="UpdateChannel" SelectedIndex="0">
          <ComboBoxItem Content="Предварительные нативные версии" />
          <ComboBoxItem Content="Только стабильные нативные версии" />
         </ComboBox>
         <CheckBox x:Name="AutoCheckUpdates" Content="Проверять обновления при запуске (GitHub)" IsChecked="True" Margin="0,8,0,4" />
         <WrapPanel>
          <Button Content="Сохранить" Click="SaveUpdateOptions" />
          <Button Content="Проверить обновления" Click="CheckUpdates" />
          <Button x:Name="InstallUpdateButton" Content="Скачать и перезапустить" Click="InstallUpdate" IsEnabled="False" />
          <Button Content="Установить из ZIP…" Click="InstallLocalUpdate" />
         </WrapPanel>
         <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,8" Visibility="Collapsed" />
         <TextBlock x:Name="UpdateStatus" Text="Обновления устанавливаются по кнопке; отправка перед перезапуском завершается." TextWrapping="Wrap" Foreground="#B4B9C6" />
         <TextBlock Text="Данные хранятся отдельно от Python-версии. Настройки и история сохраняются при обновлении." Style="{StaticResource MutedTextStyle}" Margin="0,18,0,8" />
         <Button Content="Открыть папку данных" Click="OpenData" HorizontalAlignment="Left" />
        </StackPanel>
       </Border>
       <Border x:Name="SettingsMigrationPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Переход с Python" Style="{StaticResource SectionTitleStyle}" />
         <TextBlock Text="Выберите папку данных: обычно %LOCALAPPDATA%\Crosspost. Все её файлы будут сохранены в защищённой копии. Исходная версия останется без изменений." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,10,0,12" />
         <TextBox x:Name="MigrationSource" IsReadOnly="True" />
         <Button Content="Выбрать папку данных Python…" Click="ChooseMigrationSource" HorizontalAlignment="Left" />
         <CheckBox x:Name="MigrationPythonClosed" Content="Python-версия, её фоновая очередь и браузеры закрыты" Margin="0,10,0,10" />
         <Button Content="Создать защищённую копию и прочитать данные" Click="ImportPythonProfile" HorizontalAlignment="Left" />
         <TextBlock x:Name="MigrationSummary" TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,12,0,12" />
         <TextBlock Text="Настройки подключений" Style="{StaticResource SectionTitleStyle}" />
         <TextBlock Text="Выберите назначения для переноса. В этой версии можно подключить один канал Telegram и один webhook Discord. Остальные сохранены в копии. Настройки применяются в деморежиме; сетевых запросов при импорте нет." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,8" />
         <CheckBox x:Name="MigrationTelegram" Content="Перенести Telegram и токен бота" />
         <ComboBox x:Name="MigrationChannels" Margin="0,6,0,10" />
         <CheckBox x:Name="MigrationDiscord" Content="Перенести Discord и секрет webhook" />
         <ComboBox x:Name="MigrationWebhooks" Margin="0,6,0,10" />
         <CheckBox x:Name="MigrationBluesky" Content="Перенести имя Bluesky (пароль приложения потребуется указать заново)" />
         <CheckBox x:Name="MigrationReplace" Content="Разрешить замену существующих настроек выбранных площадок" Margin="0,12,0,8" />
         <Button Content="Применить выбранные настройки" Click="ApplyMigrationSettings" HorizontalAlignment="Left" />
         <TextBlock Text="Черновики, шаблоны и задания для проверки" Style="{StaticResource SectionTitleStyle}" Margin="0,20,0,8" />
         <TextBlock Text="Расписание здесь на паузе: откройте запись в редакторе, проверьте текст и назначения, затем назначьте время заново. Неподдерживаемые поля остаются в защищённой копии." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
         <ListBox x:Name="MigrationItems" MaxHeight="230" Margin="0,10,0,8" />
         <Button Content="Открыть выбранное в редакторе…" Click="OpenMigrationDraft" HorizontalAlignment="Left" />
         <Button Content="Импортировать историю и статистику из копии" Click="ImportMigrationHistory" HorizontalAlignment="Left" />
         <Button Content="Открыть существующую защищённую копию…" Click="OpenMigrationArchive" HorizontalAlignment="Left" />
         <Button Content="Восстановить исходные файлы из копии…" Click="RestoreMigrationArchive" HorizontalAlignment="Left" />
         <TextBlock Text="Защищённая копия открывается только текущим пользователем Windows на этом ПК. При восстановлении исходные файлы, включая API-ключи, будут записаны в выбранную новую папку в исходном виде. Внешние папки моделей/экспортов не включены." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
       </Border>
       <Border x:Name="SettingsDestinationsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed"><StackPanel>
        <TextBlock Text="Каналы публикации" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock Text="Дополнительные каналы Telegram используют бота из настроек Telegram. При смене бота сохраните назначения заново. Каждый Discord webhook хранится отдельно. Назначения выбираются в редакторе; рейтинг проверяется перед отправкой. Основные подключения остаются в настройках площадок." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,12" />
        <ListBox x:Name="DestinationSettingsList" MaxHeight="200" SelectionChanged="DestinationSettingsSelected" />
        <Button Content="Новое назначение" Click="NewDestination" HorizontalAlignment="Left" />
        <TextBlock x:Name="DestinationEditorHeading" Text="Новое назначение" Style="{StaticResource SectionTitleStyle}" Margin="0,15,0,8" />
        <TextBlock Text="Название" /><TextBox x:Name="DestinationName" />
        <ComboBox x:Name="DestinationPlatform" SelectionChanged="DestinationPlatformChanged"><ComboBoxItem Content="Telegram" /><ComboBoxItem Content="Discord" /></ComboBox>
        <StackPanel x:Name="DestinationTelegramPanel"><TextBlock Text="Канал: @имя или -100…" /><TextBox x:Name="DestinationAddress" /></StackPanel>
        <StackPanel x:Name="DestinationSecretPanel" Visibility="Collapsed"><TextBlock Text="Webhook Discord — секретная ссылка" /><PasswordBox x:Name="DestinationSecret" /></StackPanel>
        <TextBlock Text="Какие посты сюда отправлять" />
        <ComboBox x:Name="DestinationRating" SelectedIndex="0"><ComboBoxItem Content="Любой рейтинг" /><ComboBoxItem Content="Только SFW" /><ComboBoxItem Content="Только 18+" /></ComboBox>
        <CheckBox x:Name="DestinationEnabled" Content="Назначение включено" IsChecked="True" Margin="0,10,0,0" />
        <CheckBox x:Name="DestinationDemo" Content="Деморежим — без сетевых запросов и публикаций" IsChecked="True" />
        <StackPanel x:Name="DestinationDiscordOptions" Visibility="Collapsed"><CheckBox x:Name="DestinationSpoiler" Content="Изображения под спойлером" /><CheckBox x:Name="DestinationEmbeds" Content="Убирать карточки ссылок" IsChecked="True" /></StackPanel>
        <WrapPanel><Button Content="Сохранить назначение" Click="SaveDestination" /><Button Content="Удалить выбранное" Click="DeleteDestination" /></WrapPanel>
        <TextBlock Text="Изменение адреса или webhook не перенаправляет старые задания: они приостанавливаются для проверки. В реальном режиме сохранение Discord проверяет только сведения о канале." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
       </StackPanel></Border>
       <Border x:Name="SettingsTextsPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Отдельные тексты площадок" Style="{StaticResource SectionTitleStyle}" />
         <TextBlock Text="Включите нужные площадки. В редакторе появится переключатель отдельного текста; общий текст и сохранённые варианты останутся доступны." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,8,0,8" />
         <WrapPanel>
          <CheckBox x:Name="CustomTelegram" Content="Telegram" Margin="0,0,18,0" />
          <CheckBox x:Name="CustomDiscord" Content="Discord" Margin="0,0,18,0" />
          <CheckBox Margin="0,0,18,0" x:Name="CustomBluesky" Content="Bluesky" />
         </WrapPanel>
         <Button Content="Сохранить отдельные тексты" Click="SaveCustomTextSettings" HorizontalAlignment="Left" />
        </StackPanel>
       </Border>
       <Border x:Name="SettingsTelegramPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Telegram • основной канал и бот" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,16" />
         <CheckBox x:Name="DemoInput" Content="Деморежим основного канала — без запросов в Telegram" IsChecked="True" />
         <TextBlock Text="Канал: @имя или -100…" />
         <TextBox x:Name="ChatInput" />
         <TextBlock Text="Рейтинг основного канала" /><ComboBox x:Name="PrimaryTelegramRating" SelectedIndex="0"><ComboBoxItem Content="Любой рейтинг" /><ComboBoxItem Content="Только SFW" /><ComboBoxItem Content="Только 18+" /></ComboBox>
         <TextBlock Text="Токен бота из @BotFather" />
         <PasswordBox x:Name="TokenInput" />
         <TextBlock Text="Токен сохраняется с защитой Windows для текущего пользователя. Бот должен быть администратором выбранного канала." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,0,0,12" />
         <WrapPanel>
          <Button Content="Сохранить настройки" Click="SaveSettings" />
          <Button Content="Проверить бота" Click="CheckBot" />
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border x:Name="SettingsDiscordPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Discord • основной webhook" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
         <CheckBox x:Name="DiscordDemoInput" Content="Деморежим основного webhook — без запросов и публикаций" IsChecked="True" />
         <TextBlock Text="Ссылка webhook (секрет)" />
         <PasswordBox x:Name="DiscordWebhookInput" />
         <TextBlock Text="Рейтинг основного webhook" /><ComboBox x:Name="PrimaryDiscordRating" SelectedIndex="0"><ComboBoxItem Content="Любой рейтинг" /><ComboBoxItem Content="Только SFW" /><ComboBoxItem Content="Только 18+" /></ComboBox>
         <TextBlock x:Name="DiscordTargetLabel" Text="Канал пока не проверен" TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,0,0,12" />
         <CheckBox x:Name="DiscordSpoilerInput" Content="Скрывать изображения под спойлер" />
         <CheckBox x:Name="DiscordEmbedsInput" Content="Убирать карточки ссылок" IsChecked="True" />
         <WrapPanel>
          <Button Content="Сохранить Discord" Click="SaveDiscordSettings" />
          <Button Content="Проверить webhook" Click="CheckDiscord" />
         </WrapPanel>
         <TextBlock Text="Проверка только читает сведения о webhook. Ссылка хранится с защитой Windows; в задания записываются ID webhook и канала. Публикация: до 2000 символов и 10 JPEG/PNG до 20 MiB каждый, всего до 24 MiB. Упоминания не вызывают уведомлений." TextWrapping="Wrap" Foreground="#B4B9C6" Margin="0,12,0,0" />
        </StackPanel>
       </Border>
       <Border x:Name="SettingsBlueskyPanel" Style="{StaticResource CardStyle}" Visibility="Collapsed">
        <StackPanel>
         <TextBlock Text="Bluesky • пароль приложения" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12" />
         <CheckBox x:Name="BlueskyDemoInput" Content="Деморежим Bluesky — без входа и публикаций" IsChecked="True" />
         <TextBlock Text="Handle" />
         <TextBox x:Name="BlueskyHandleInput" />
         <TextBlock Text="Пароль приложения из настроек Bluesky" />
         <PasswordBox x:Name="BlueskyPasswordInput" />
         <TextBlock x:Name="BlueskyAccountLabel" Text="Аккаунт пока не проверен" TextWrapping="Wrap" Foreground="#B4B9C6" />
         <WrapPanel>
          <Button Content="Сохранить Bluesky" Click="SaveBlueskySettings" />
          <Button Content="Проверить вход" Click="CheckBluesky" />
         </WrapPanel>
         <TextBlock Text="Проверка выполняет вход без создания поста. Пароль приложения защищается Windows DPAPI; сессия используется только во время действия. В этой версии поддерживаются аккаунты на серверах Bluesky; собственные PDS пока не подключены." TextWrapping="Wrap" Foreground="#B4B9C6" />
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,8">
   <DockPanel>
    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отменить" Click="CancelOperation" Visibility="Collapsed" />
    <StackPanel>
     <TextBlock x:Name="StatusLabel" Style="{StaticResource MutedTextStyle}" FontSize="12" Text="Загрузка…" TextWrapping="Wrap" />
     <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,8,0,0" />
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
