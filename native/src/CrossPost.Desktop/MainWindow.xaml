<Window x:Class="CrossPost.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource AppWindowStyle}" Icon="/Assets/CrossPost.ico" Title="CrossPost Native — прототип" Width="1100" Height="800" MinWidth="850" MinHeight="650">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="crosspost / native" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock x:Name="ModeLabel" Text="ДЕМО • ничего не публикуется" Foreground="#65DBB2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
   <WrapPanel Grid.Row="1">
    <Button x:Name="NavCompose" Content="Новый пост" Click="ShowCompose"/><Button x:Name="NavLibrary" Content="Публикации" Click="ShowLibrary"/><Button x:Name="NavStats" Content="Статистика" Click="ShowLibraryStats"/><Button x:Name="NavQueue" Content="Очередь" Click="ShowQueue"/><Button x:Name="NavHistory" Content="История • правки" Click="ShowHistory"/><Button x:Name="NavSettings" Content="Настройки" Click="ShowSettings"/><Button x:Name="UpdateNotice" Content="Доступно обновление" Click="ShowSettings" Visibility="Collapsed" Background="#16815C"/>
   </WrapPanel>
  </Grid>
  <Grid x:Name="MainContent" Grid.Row="1">
   <ScrollViewer x:Name="ComposeView" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
     <TextBlock Text="Новый пост" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <WrapPanel Margin="0,0,0,10"><TextBlock Text="Предпросмотр" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PlatformPicker" Width="180" SelectedIndex="0" SelectionChanged="PlatformChanged"><ComboBoxItem Content="Telegram"/><ComboBoxItem Content="Discord"/><ComboBoxItem Content="Bluesky"/></ComboBox></WrapPanel>
     <Border Background="{StaticResource Panel}" Padding="12" Margin="0,0,0,12"><StackPanel>
      <TextBlock Text="Куда опубликовать" FontWeight="SemiBold"/>
      <WrapPanel Margin="0,6,0,4"><CheckBox x:Name="TargetTelegram" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged" Content="Telegram" IsChecked="True" Margin="0,0,20,0"/><CheckBox x:Name="TargetDiscord" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged" Content="Discord" Margin="0,0,20,0"/><CheckBox Margin="0,0,20,0" x:Name="TargetBluesky" Checked="TargetSelectionChanged" Unchecked="TargetSelectionChanged" Content="Bluesky"/></WrapPanel>
      <TextBlock x:Name="TargetSummary" TextWrapping="Wrap" Margin="0,4,0,6" Foreground="#65DBB2"/>
      <TextBlock Text="Отметьте назначения для общего запуска. Выбор площадки выше переключает предпросмотр и её параметры." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     </StackPanel></Border>
     <TextBlock Text="Общий язык публикации" FontWeight="SemiBold"/>
     <WrapPanel Margin="0,6,0,12"><RadioButton x:Name="MainLanguageRu" GroupName="MainTextLanguage" Content="Русский" IsChecked="True" Checked="TextLanguageChanged" Margin="0,0,18,0"/><RadioButton x:Name="MainLanguageBoth" GroupName="MainTextLanguage" Content="Оба" Checked="TextLanguageChanged" Margin="0,0,18,0"/><RadioButton x:Name="MainLanguageEnglish" GroupName="MainTextLanguage" Content="English" Checked="TextLanguageChanged"/></WrapPanel>
     <TextBlock Text="Русский · заголовок"/><TextBox x:Name="TitleInput" TextChanged="DraftChanged"/>
     <TextBlock Text="Русский · описание"/><TextBox x:Name="BodyInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged"/>
     <Expander x:Name="EnglishEditor" Header="English · название и описание" Margin="0,0,0,14"><StackPanel Margin="8">
      <TextBlock Text="English · title"/><TextBox x:Name="EnglishTitleInput" TextChanged="DraftChanged"/>
      <TextBlock Text="English · description"/><TextBox x:Name="EnglishBodyInput" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged"/>
      <TextBlock Text="Английский вариант вводится вручную. В режиме «Оба» русский текст идёт первым, затем английский." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     </StackPanel></Expander>
     <Border Background="{StaticResource Panel}" Padding="12" Margin="0,0,0,14"><StackPanel>
      <TextBlock x:Name="PlatformTextHeading" Text="Текст для Telegram" FontWeight="SemiBold"/>
      <WrapPanel Margin="0,6,0,6"><TextBlock Text="Язык площадки" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PlatformLanguage" Width="200" SelectedIndex="0" SelectionChanged="PlatformLanguageChanged"><ComboBoxItem Content="Как в общем тексте"/><ComboBoxItem Content="Русский"/><ComboBoxItem Content="Оба"/><ComboBoxItem Content="English"/></ComboBox></WrapPanel>
      <CheckBox x:Name="CustomTextToggle" Content="Использовать отдельный текст для этой площадки" Visibility="Collapsed" Checked="CustomTextToggled" Unchecked="CustomTextToggled"/>
      <Expander x:Name="PlatformTextEditor" Header="Отдельные заголовки и описания" Margin="0,8,0,0"><StackPanel x:Name="CustomTextFields" Visibility="Collapsed" Margin="8">
       <TextBlock Text="Русский · заголовок"/><TextBox x:Name="CustomTitleInput" TextChanged="CustomTextChanged"/>
       <TextBlock Text="Русский · описание"/><TextBox x:Name="CustomBodyInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CustomTextChanged"/>
       <TextBlock Text="English · title"/><TextBox x:Name="CustomEnglishTitleInput" TextChanged="CustomTextChanged"/>
       <TextBlock Text="English · description"/><TextBox x:Name="CustomEnglishBodyInput" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="CustomTextChanged"/>
      </StackPanel></Expander>
      <TextBlock Text="Отдельные тексты включаются для каждой площадки в настройках. Язык можно выбрать независимо от отдельного текста." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <WrapPanel><Button Content="Добавить изображения" Click="PickImage"/><Button x:Name="RemoveImageButton" Content="Убрать выбранное" Click="RemoveImage"/><Button Content="Новый черновик" Click="ClearDraft"/></WrapPanel>
     <WrapPanel><Button x:Name="MoveImageUpButton" Content="Выше" Click="MoveImageUp"/><Button x:Name="MoveImageDownButton" Content="Ниже" Click="MoveImageDown"/></WrapPanel>
     <ListBox x:Name="ImageList" MaxHeight="130" Background="#242A36" Foreground="#EDF0F7" DisplayMemberPath="Label" SelectionChanged="ImageSelected"/>
     <StackPanel x:Name="BlueskyComposer" Visibility="Collapsed" Margin="0,8,0,8">
      <WrapPanel><TextBlock Text="Рейтинг Bluesky" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="BlueskyRating" Width="180" SelectedIndex="0" SelectionChanged="BlueskyRatingChanged"><ComboBoxItem Content="SFW"/><ComboBoxItem Content="Эротика • nudity"/><ComboBoxItem Content="Откровенное • porn"/></ComboBox></WrapPanel>
      <TextBlock Text="ALT выбранного изображения" Margin="0,8,0,0"/><TextBox x:Name="ImageAltInput" TextChanged="ImageAltChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="65"/>
      <Button Content="Подготовить копии для Bluesky" Click="PrepareBlueskyImages" HorizontalAlignment="Left"/>
      <TextBlock Text="До 4 изображений по 2 000 000 байт. Подготовка сохраняет PNG с прозрачностью, если он помещается; иначе создаёт JPEG на белом фоне. Оригиналы сохраняются. Результат появится в предпросмотре." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     </StackPanel>
     <TextBlock x:Name="ImageLabel" TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,8,0,8"/>
     <Image x:Name="PreviewImage" Visibility="Collapsed" Height="130" Stretch="Uniform" HorizontalAlignment="Left"/>
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,14,0,14">
      <StackPanel><TextBlock x:Name="PreviewHeading" Text="Предпросмотр текста Telegram" FontWeight="SemiBold"/><TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="CountLabel" Foreground="#ABB5CA" Margin="0,10,0,0"/></StackPanel>
     </Border>
     <TextBlock x:Name="DestinationLabel" TextWrapping="Wrap"/>

     <TextBlock x:Name="ScheduleZoneLabel" Text="Публикация по расписанию"/>
     <WrapPanel Margin="0,5,0,8"><DatePicker x:Name="ScheduleDate" Width="145" Margin="0,4,10,4"/><TextBox x:Name="ScheduleClock" Text="12:00" Width="85" Margin="0,4,10,4"/><Button Content="Запланировать" Click="SchedulePost"/></WrapPanel>
     <TextBlock Text="Очередь работает после закрытия окна, пока включён компьютер. Текст, файлы и канал сохраняются в задании." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,0,0,14"/>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="HistoryView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="История" FontSize="26" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Обновить" HorizontalAlignment="Right" Click="RefreshHistory"/></DockPanel>
    <ListView Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="HistorySelected" Background="#1A1E27" Foreground="#EDF0F7" Margin="0,12,0,10">
     <ListView.View><GridView>
      <GridViewColumn Header="Дата" Width="145" DisplayMemberBinding="{Binding CreatedText}"/>
      <GridViewColumn Header="Пост" Width="260" DisplayMemberBinding="{Binding Title}"/>
      <GridViewColumn Header="Результат" Width="200" DisplayMemberBinding="{Binding Status}"/>
      <GridViewColumn Header="Режим" Width="85" DisplayMemberBinding="{Binding Mode}"/>
     </GridView></ListView.View>
    </ListView>
    <StackPanel Grid.Row="2">
     <TextBlock x:Name="HistoryDetails" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="Изменить текст или подпись (обычный текст)"/>
     <TextBox x:Name="EditInput" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <WrapPanel><Button x:Name="EditButton" Content="Сохранить изменение" Click="EditPost" IsEnabled="False"/><Button Content="Открыть сообщение" Click="OpenPost"/></WrapPanel>
    </StackPanel>
   </Grid>
   <Grid x:Name="QueueView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Очередь публикаций" FontSize="26" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,10,0,10">
     <TextBlock x:Name="WorkerLabel" TextWrapping="Wrap"/>
     <WrapPanel><Button Content="Запустить очередь" Click="StartWorker"/><Button Content="Остановить очередь" Click="StopWorker"/><Button Content="Обновить" Click="RefreshQueue"/></WrapPanel>
    </StackPanel>
    <ListView Grid.Row="2" x:Name="QueueList" ItemsSource="{Binding Queue}" SelectionChanged="QueueSelected" Background="#1A1E27" Foreground="#EDF0F7">
     <ListView.View><GridView>
      <GridViewColumn Header="Когда (местное время)" Width="160" DisplayMemberBinding="{Binding DueText}"/>
      <GridViewColumn Header="Пост" Width="220" DisplayMemberBinding="{Binding Title}"/>
      <GridViewColumn Header="Назначение" Width="180" DisplayMemberBinding="{Binding Destination}"/>
      <GridViewColumn Header="Состояние" Width="200" DisplayMemberBinding="{Binding Status}"/>
     </GridView></ListView.View>
    </ListView>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
     <TextBlock x:Name="QueueDetails" TextWrapping="Wrap"/>
     <WrapPanel><Button x:Name="PauseJobButton" Content="Приостановить" Click="PauseJob" IsEnabled="False"/><Button x:Name="ResumeJobButton" Content="Продолжить / перенести" Click="ResumeJob" IsEnabled="False"/><Button x:Name="CancelJobButton" Content="Отменить задание" Click="CancelJob" IsEnabled="False"/><Button x:Name="JobHistoryButton" Content="Результат в истории" Click="OpenJobHistory" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="Для переноса выберите дату и время ниже. Повтор неизвестной или частичной отправки автоматически не выполняется." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     <WrapPanel Margin="0,5,0,0"><DatePicker x:Name="QueueDate" Width="145" Margin="0,4,10,4"/><TextBox x:Name="QueueClock" Width="85" Margin="0,4,10,4"/></WrapPanel>
    </StackPanel>
   </Grid>
   <Grid x:Name="LibraryView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="Публикации" FontSize="26" FontWeight="SemiBold" Margin="0,0,18,0"/><Button Content="Импорт Python-базы…" Click="ImportLegacy"/><Button Content="Обновить" Click="RefreshLibrary"/><CheckBox x:Name="IncludeDemo" Content="Демо" Checked="LibraryFilterChanged" Unchecked="LibraryFilterChanged" VerticalAlignment="Center" Margin="5"/></WrapPanel>
    <Grid Grid.Row="1" Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
      <StackPanel>
       <WrapPanel><Button Content="‹" Click="PreviousLibraryMonth"/><TextBlock x:Name="LibraryMonthLabel" FontSize="18" VerticalAlignment="Center" Margin="4"/><Button Content="›" Click="NextLibraryMonth"/><Button Content="Месяц" Click="ClearLibraryDay"/></WrapPanel>
       <UniformGrid Columns="7"><TextBlock Text="Пн"/><TextBlock Text="Вт"/><TextBlock Text="Ср"/><TextBlock Text="Чт"/><TextBlock Text="Пт"/><TextBlock Text="Сб"/><TextBlock Text="Вс"/></UniformGrid>
       <ItemsControl x:Name="CalendarDays" Height="228"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Date}" Click="SelectLibraryDay" FontSize="11" Padding="0" Margin="1" Background="{Binding Background}" ToolTip="{Binding Detail}"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock x:Name="LibrarySummary" TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,12,0,0"/>
       <TextBlock x:Name="ImportSummary" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#65DBB2"/>
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListView x:Name="WorkList" SelectionMode="Extended" SelectionChanged="WorkSelected" Background="#1A1E27" Foreground="#EDF0F7">
       <ListView.View><GridView><GridViewColumn Header="Дата" Width="125" DisplayMemberBinding="{Binding DateLabel}"/><GridViewColumn Header="Работа" Width="230" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="Площадки" Width="150" DisplayMemberBinding="{Binding Platforms}"/><GridViewColumn Header="Результат" Width="160" DisplayMemberBinding="{Binding StateLabel}"/><GridViewColumn Header="Связь" Width="160" DisplayMemberBinding="{Binding GroupLabel}"/></GridView></ListView.View>
      </ListView>
      <StackPanel Grid.Row="1" Margin="0,8,0,0"><WrapPanel><Button Content="Объединить" Click="JoinWorks" ToolTip="Объединить любые выбранные работы, сохранив все публикации и замеры"/><Button Content="Разъединить" Click="SplitWorks"/><Button Content="Открыть" Click="OpenLibraryPost"/></WrapPanel><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="WorkDetails" TextWrapping="Wrap" Foreground="#ABB5CA"/></ScrollViewer></StackPanel>
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="LibraryStatsView" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="Статистика" FontSize="26" FontWeight="SemiBold" Margin="0,0,20,0"/><Button Content="Обновить локальные данные" Click="RefreshLibrary"/></WrapPanel>
    <TextBlock Grid.Row="1" Text="Фактические импортированные замеры. Для каждой работы и назначения учитывается последняя успешная публикация. Демо и исключённые записи не учитываются. «—» означает отсутствие данных." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,12,0,12"/>
    <ListView Grid.Row="2" x:Name="TotalsList" Background="#1A1E27" Foreground="#EDF0F7"><ListView.View><GridView>
     <GridViewColumn Header="Площадка" Width="130" DisplayMemberBinding="{Binding Platform}"/><GridViewColumn Header="Назначение" Width="180" DisplayMemberBinding="{Binding Target}"/><GridViewColumn Header="Публикаций" Width="100" DisplayMemberBinding="{Binding Publications}"/><GridViewColumn Header="Просмотры" Width="140" DisplayMemberBinding="{Binding ViewsLabel}"/><GridViewColumn Header="Реакции" Width="140" DisplayMemberBinding="{Binding ReactionsLabel}"/>
    </GridView></ListView.View></ListView>
    <TextBlock Grid.Row="3" Text="Сеть и браузеры этот раздел не запускает. Подробные замеры по публикациям — в календаре. Сбор новых метрик и индекс успеха будут подключены отдельно." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,20,0,0"/>
   </Grid>
   <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,0,0,20"><StackPanel>
      <TextBlock Text="Обновления CrossPost Native" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="UpdateVersionLabel" Margin="0,8,0,8"/>
      <ComboBox x:Name="UpdateChannel" SelectedIndex="0"><ComboBoxItem Content="Предварительные нативные версии"/><ComboBoxItem Content="Только стабильные нативные версии"/></ComboBox>
      <CheckBox x:Name="AutoCheckUpdates" Content="Проверять обновления при запуске (GitHub)" IsChecked="True" Margin="0,8,0,4"/>
      <WrapPanel><Button Content="Сохранить" Click="SaveUpdateOptions"/><Button Content="Проверить обновления" Click="CheckUpdates"/><Button x:Name="InstallUpdateButton" Content="Скачать и перезапустить" Click="InstallUpdate" IsEnabled="False"/><Button Content="Установить из ZIP…" Click="InstallLocalUpdate"/></WrapPanel>
      <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Margin="0,8,0,8" Visibility="Collapsed"/>
      <TextBlock x:Name="UpdateStatus" Text="Обновления устанавливаются по кнопке; отправка перед перезапуском завершается." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     </StackPanel></Border>
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,0,0,20"><StackPanel>
      <TextBlock Text="Отдельные тексты площадок" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Включите нужные площадки. В редакторе появится переключатель отдельного текста; общий текст и сохранённые варианты останутся доступны." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,8,0,8"/>
      <WrapPanel><CheckBox x:Name="CustomTelegram" Content="Telegram" Margin="0,0,18,0"/><CheckBox x:Name="CustomDiscord" Content="Discord" Margin="0,0,18,0"/><CheckBox Margin="0,0,18,0" x:Name="CustomBluesky" Content="Bluesky"/></WrapPanel>
      <Button Content="Сохранить отдельные тексты" Click="SaveCustomTextSettings" HorizontalAlignment="Left"/>
     </StackPanel></Border>
     <TextBlock Text="Настройки Telegram" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <CheckBox x:Name="DemoInput" Content="Демонстрационный режим — без запросов в Telegram" IsChecked="True"/>
     <TextBlock Text="Канал: @имя или -100…"/><TextBox x:Name="ChatInput" MinWidth="550"/>
     <TextBlock Text="Токен бота из @BotFather"/><PasswordBox x:Name="TokenInput"/>
     <TextBlock Text="Токен сохраняется с защитой Windows для текущего пользователя. Бот должен быть администратором выбранного канала." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Сохранить настройки" Click="SaveSettings"/><Button Content="Проверить бота" Click="CheckBot"/><Button Content="Открыть папку данных" Click="OpenData"/></WrapPanel>
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,20,0,0"><StackPanel>
      <TextBlock Text="Discord • webhook канала" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <CheckBox x:Name="DiscordDemoInput" Content="Демонстрационный режим Discord — без запросов и публикаций" IsChecked="True"/>
      <TextBlock Text="Ссылка webhook (секрет)"/><PasswordBox x:Name="DiscordWebhookInput"/>
      <TextBlock x:Name="DiscordTargetLabel" Text="Канал пока не проверен" TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,0,0,12"/>
      <CheckBox x:Name="DiscordSpoilerInput" Content="Скрывать изображения под спойлер"/>
      <CheckBox x:Name="DiscordEmbedsInput" Content="Убирать карточки ссылок" IsChecked="True"/>
      <WrapPanel><Button Content="Сохранить Discord" Click="SaveDiscordSettings"/><Button Content="Проверить webhook" Click="CheckDiscord"/></WrapPanel>
      <TextBlock Text="Проверка только читает сведения о webhook. Ссылка хранится с защитой Windows; в задания записываются ID webhook и канала. Публикация: до 2000 символов и 10 JPEG/PNG до 20 MiB каждый, всего до 24 MiB. Упоминания не вызывают уведомлений." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,12,0,0"/>
     </StackPanel></Border>
     <Border Background="{StaticResource Panel}" Padding="16" Margin="0,20,0,0"><StackPanel>
      <TextBlock Text="Bluesky • пароль приложения" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <CheckBox x:Name="BlueskyDemoInput" Content="Деморежим Bluesky — без входа и публикаций" IsChecked="True"/>
      <TextBlock Text="Handle"/><TextBox x:Name="BlueskyHandleInput"/>
      <TextBlock Text="Пароль приложения из настроек Bluesky"/><PasswordBox x:Name="BlueskyPasswordInput"/>
      <TextBlock x:Name="BlueskyAccountLabel" Text="Аккаунт пока не проверен" TextWrapping="Wrap" Foreground="#ABB5CA"/>
      <WrapPanel><Button Content="Сохранить Bluesky" Click="SaveBlueskySettings"/><Button Content="Проверить вход" Click="CheckBluesky"/></WrapPanel>
      <TextBlock Text="Проверка выполняет вход без создания поста. Пароль приложения защищается Windows DPAPI; сессия используется только во время действия. В этой версии поддерживаются аккаунты на серверах Bluesky; собственные PDS пока не подключены." TextWrapping="Wrap" Foreground="#ABB5CA"/>
     </StackPanel></Border>
     <TextBlock Text="В прототипе: Telegram, Discord и Bluesky, очередь, история, импорт Python-базы и локальная статистика. MTProto, видео и остальные адаптеры будут добавлены отдельно." TextWrapping="Wrap" Foreground="#ABB5CA" Margin="0,20,0,12"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource Panel}" Padding="12" Margin="0,18,0,0">
   <StackPanel>
    <WrapPanel x:Name="ComposeActions" Margin="0,0,0,8"><Button Style="{StaticResource PrimaryButtonStyle}" x:Name="SendButton" Content="Опубликовать в выбранные" Click="SendPost"/><Button Content="В очередь" Click="QueueNow"/><Button Content="Сохранить черновик" Click="SaveDraftClick"/></WrapPanel>
   <DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Отменить" Click="CancelOperation" Visibility="Collapsed"/><StackPanel><TextBlock x:Name="StatusLabel" Text="Загрузка…" TextWrapping="Wrap"/><ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</Window>
